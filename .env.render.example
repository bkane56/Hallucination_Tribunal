# Render API service (see render.yaml and docs/deployment.md)
# Set FRONTEND_URL and CORS_ALLOWED_ORIGINS to your Vercel production URL.

APP_ENV=production
FRONTEND_URL=https://hallucination-tribunal.vercel.app
CORS_ALLOWED_ORIGINS=https://hallucination-tribunal.vercel.app

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://consultationAI:11434
OLLAMA_MODEL=llama3.2:1b

EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

VECTOR_DB_PROVIDER=chromadb
RETRIEVAL_MODE=hybrid
LOG_LEVEL=info

EMBEDDING_BATCH_SIZE=16
OLLAMA_EMBEDDING_TIMEOUT=90
OLLAMA_LLM_TIMEOUT=180
OLLAMA_KEEP_ALIVE=10m

CHROMA_PERSIST_DIRECTORY=/app/data/chroma
SQLITE_DATABASE_PATH=/app/data/tribunal.db
UPLOAD_DIRECTORY=/app/data/uploads
SEED_DIRECTORY=/app/data/seed
EVALS_DIRECTORY=/app/data/evals
