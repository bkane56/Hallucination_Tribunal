# Render API service (see render.yaml and docs/deployment.md)
# Set OPENAI_API_KEY, FRONTEND_URL, and CORS_ALLOWED_ORIGINS in the Render dashboard.

APP_ENV=production
FRONTEND_URL=https://hallucination-tribunal.vercel.app
CORS_ALLOWED_ORIGINS=https://hallucination-tribunal.vercel.app

# Default production: OpenAI for LLM and embeddings
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: switch to private Ollama (see docs/deployment.md)
# LLM_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://consultationAI:11434
# OLLAMA_MODEL=llama3.2:1b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

VECTOR_DB_PROVIDER=chromadb
RETRIEVAL_MODE=hybrid
LOG_LEVEL=info

EMBEDDING_BATCH_SIZE=16
OLLAMA_EMBEDDING_TIMEOUT=90
OLLAMA_LLM_TIMEOUT=180
OLLAMA_KEEP_ALIVE=10m

CHROMA_PERSIST_DIRECTORY=/app/data/chroma
SQLITE_DATABASE_PATH=/app/data/tribunal.db
UPLOAD_DIRECTORY=/app/data/uploads
SEED_DIRECTORY=/app/data/seed
EVALS_DIRECTORY=/app/data/evals
