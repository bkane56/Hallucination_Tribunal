APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Comma-separated extra CORS origins (production API only)
CORS_ALLOWED_ORIGINS=
# Vercel Services API mount path (web uses NEXT_PUBLIC_API_ROUTE_PREFIX)
API_ROOT_PATH=/server
# Writable data root on serverless hosts (auto-set to /tmp on Vercel)
STORAGE_ROOT=

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Embeddings index uploads/retrieval only (no LLM). Options: local | ollama | openai
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional hosted providers (document text leaves your infra when used)
OPENAI_API_KEY=sk-********
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

VECTOR_DB_PROVIDER=chromadb
CHROMA_PERSIST_DIRECTORY=./data/chroma
SQLITE_DATABASE_PATH=./data/tribunal.db

MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=900
CHUNK_OVERLAP=150
# Ollama/OpenAI embed API batch size and per-batch timeout (seconds)
EMBEDDING_BATCH_SIZE=16
OLLAMA_EMBEDDING_TIMEOUT=90
TOP_K_DEFAULT=6

RETRIEVAL_MODE=hybrid

LOG_LEVEL=info
