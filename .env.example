APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
