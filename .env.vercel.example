# Vercel all-in-one deployment (see docs/deployment.md)
# Leave NEXT_PUBLIC_BACKEND_URL unset to use same-origin /server API routes.
NEXT_PUBLIC_API_ROUTE_PREFIX=/server

# API service (set in Vercel project env — shared across web + api services)
APP_ENV=production
API_ROOT_PATH=/server
FRONTEND_URL=https://your-app.vercel.app

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://your-ollama-host.example.com
OLLAMA_MODEL=llama3.1:8b

# Recommended on Vercel: call your Ollama host for embeddings (no document text to OpenAI)
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional hosted fallback (sends document chunks to OpenAI — not recommended for proprietary docs)
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-********
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini
